# === Amazon RDS PostgreSQL ===
RDS_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# Solo poner "always" la primera vez para cargar los datos iniciales de catalog; luego "never"
CATALOG_SQL_INIT_MODE=always

# === RabbitMQ Clúster ===
RABBITMQ_USERNAME=digitalfix
RABBITMQ_PASSWORD=CAMBIAR_PASSWORD_RABBIT
RABBITMQ_ERLANG_COOKIE=DIGITALFIX_CLUSTER_SECRET_COOKIE_2026

# === Microsoft Entra ID (Azure AD) para el BFF ===
AZURE_TENANT_ID=eb95c5e2-ef47-4188-9dcf-8a1b3e5edf85
AZURE_AUDIENCES=api://57b76df2-6cba-40ec-9be5-98567941aad4

# === CORS del BFF (URL HTTPS de CloudFront cuando la tengamos) ===
CORS_ALLOWED_ORIGINS=http://localhost:4200